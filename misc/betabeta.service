[Unit]
Description=betabeta (Gluetun podman manager)
After=network.target
Wants=network.target

[Service]
Type=simple
WorkingDirectory=__BETABETA_CONFIG_DIR__
ExecStart=__BETABETA_BIN_PATH__
Environment=BETABETA_CONFIG=__BETABETA_CONFIG_TOML__
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
